# Copier en .env et remplir. Le .env n'est JAMAIS versionne ni copie dans
# l'image Docker (voir .gitignore et .dockerignore).
#
# En production, ce fichier est materialise sur le VPS par le workflow de
# deploiement a partir des secrets GitHub Actions, en chmod 600.

# --- Base de donnees -------------------------------------------------------
POSTGRES_USER=catalog
POSTGRES_PASSWORD=            # OBLIGATOIRE en prod. Generer : openssl rand -base64 32
POSTGRES_DB=catalog
# Le port n'est publie que sur la boucle locale du VPS, jamais sur l'exterieur.
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://catalog:CHANGEME@postgres:5432/catalog

# --- LLM -------------------------------------------------------------------
# Sans cle, l'etage semantique est saute et le reste du pipeline continue
# (degradation gracieuse). La cle se cree sur console.anthropic.com.
ANTHROPIC_API_KEY=
# Defaut : Claude Opus 5. Descendre en gamme est un arbitrage qui appartient a
# l'utilisateur, pas un defaut impose — l'interface affiche le cout reel pour
# que cet arbitrage se fasse sur des chiffres.
#   claude-opus-5     5,00 $ / 25,00 $ par million de jetons
#   claude-sonnet-5   3,00 $ / 15,00 $
#   claude-haiku-4-5  1,00 $ /  5,00 $
LLM_MODEL=claude-opus-5
# Garde-fous de cout. Mesure sur l'echantillon : 273 libelles distincts en lots
# de 25, soit 11 appels et environ 0,44 $ par run complet sur Opus 5. Le cache
# ramene les runs suivants a pres de zero.
LLM_MAX_CALLS_PER_RUN=500
LLM_MAX_COST_USD=5.0
# ENVELOPPE CUMULEE sur toute la demonstration, en dollars. Le plafond par run
# ci-dessus ne protege de rien tout seul : douze runs a 0,44 $ sous leur plafond
# depassent quand meme l'enveloppe. Une fois epuisee, l'etage LLM est saute et
# le pipeline continue — degradation visible plutot que facture inattendue.
LLM_BUDGET_USD=5.0

# --- Authentification de la plateforme -------------------------------------
# Le compte administrateur est cree au demarrage de l'API a partir de ces deux
# variables. Sans elles l'API demarre, mais aucun compte n'existe et
# l'interface est inaccessible.
ADMIN_EMAIL=
ADMIN_PASSWORD=            # OBLIGATOIRE en prod. Generer : openssl rand -base64 24
# Cle de signature des cookies de session. OBLIGATOIRE : l'API refuse de
# demarrer sans elle, et c'est voulu. Le repli de developpement est une
# constante presente dans le depot et dans l'image Docker — quiconque la lit
# peut signer un jeton `admin` et obtenir les decisions de TVA, la suppression
# de runs et le referentiel de tous les magasins. Minimum 32 caracteres.
# Generer : openssl rand -hex 32
SESSION_SECRET=

# --- Journalisation --------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# --- Chemins ---------------------------------------------------------------
DATA_DIR=/data
