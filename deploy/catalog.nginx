# Vhost ACTIF : consultation des rapports de run, en HTTPS.
#
# Le vhost de la plateforme complete (proxy vers les conteneurs api et web) est
# dans catalog-platform.nginx. Il n'est PAS installe tant que ces conteneurs
# n'existent pas : le deployer maintenant donnerait un 502 permanent.
# `main` doit rester deployable a tout instant.
#
# Nom d'hote : catalog.example.com, a remplacer par le votre. Sans domaine,
# un nom sslip.io (catalog.<ip-en-tirets>.sslip.io) resout vers l'IP du
# serveur, et Let's Encrypt delivre bien un certificat pour ce nom.
#
# Vhost SEPARE : les vhosts des sites existants ne sont pas touches, et aucun
# port supplementaire n'est ouvert (ufw autorise deja 80 et 443).

server {
    listen 80;
    listen [::]:80;
    server_name catalog.example.com;

    # Renouvellement du certificat : doit rester en HTTP et sans
    # authentification, sinon la validation ACME echoue sur un 401.
    location ^~ /.well-known/acme-challenge/ {
        auth_basic off;
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # nginx 1.18 (Ubuntu 22.04) : http2 est un parametre de `listen`.
    # La directive autonome `http2 on;` n'existe qu'a partir de 1.25.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name catalog.example.com;

    ssl_certificate     /etc/letsencrypt/live/catalog.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/catalog.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:catalog_ssl:5m;
    ssl_session_timeout 1h;

    access_log /var/log/nginx/catalog.access.log;
    error_log  /var/log/nginx/catalog.error.log;

    auth_basic "Catalog — rapports de run";
    auth_basic_user_file /etc/nginx/catalog.htpasswd;

    root /srv/catalog/reports;
    index index.html;
    autoindex on;
    autoindex_localtime on;

    location ~ \.json$ {
        default_type text/plain;
        charset utf-8;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 1m;
}
