# Vhost de la plateforme Catalog.
#
# nginx HOTE fait office de terminaison TLS et de reverse proxy vers les
# conteneurs, comme pour les autres sites du serveur. Il ne sert aucun
# fichier de l'application : le front est servi par son propre conteneur.
#
# Nom d'hote : catalog.example.com, a remplacer par le votre. Sans domaine,
# un nom sslip.io (catalog.<ip-en-tirets>.sslip.io) resout vers l'IP du
# serveur et Let's Encrypt delivre pour ce nom. Seule la directive
# server_name change.
#
# Ce vhost est SEPARE : les vhosts des sites existants ne sont pas touches.
# Aucun port supplementaire n'est ouvert, ufw autorise deja 80 et 443.

server {
    listen 80;
    listen [::]:80;
    server_name catalog.example.com;

    # Renouvellement automatique du certificat : doit rester en HTTP et sans
    # authentification, sinon la validation ACME echoue.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # nginx 1.18 (Ubuntu 22.04) : http2 est un parametre de `listen`.
    # La directive autonome `http2 on;` n'existe qu'a partir de 1.25.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name catalog.example.com;

    ssl_certificate     /etc/letsencrypt/live/catalog.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/catalog.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:catalog_ssl:5m;
    ssl_session_timeout 1h;

    access_log /var/log/nginx/catalog.access.log;
    error_log  /var/log/nginx/catalog.error.log;

    # L'authentification est desormais applicative (session + roles) : un simple
    # basic auth ne sait pas distinguer un admin, seul habilite a valider une
    # TVA, d'un relecteur. Voir api/auth.py.

    # Un CSV de catalogue fait ~1,6 Mo ; la marge couvre les gros magasins.
    client_max_body_size 32m;

    # L'API. Les timeouts sont larges : un run avec verification des 9 000 URLs
    # dure plusieurs minutes et le suivi de progression se fait en flux continu.
    location /api/ {
        proxy_pass http://127.0.0.1:3300;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # Flux d'evenements (progression du pipeline en direct). Le tampon doit
    # etre desactive, sinon nginx retient les evenements et l'interface parait
    # figee jusqu'a la fin du run.
    location /api/events {
        proxy_pass http://127.0.0.1:3300;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;
        proxy_read_timeout 3600s;
    }

    # L'interface React, servie par son conteneur.
    location / {
        proxy_pass http://127.0.0.1:3301;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Strict-Transport-Security "max-age=31536000" always;
}
